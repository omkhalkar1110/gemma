# =============================================================================
# ENVIRONMENT VARIABLES — COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# =============================================================================
# IMPORTANT: NEVER commit real API keys. Use GCP Secret Manager in production.

# Gemini / Gemma API Key (required for AI features)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Elasticsearch Configuration (optional — app works with built-in mock data)
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_API_KEY=""

# App URL (Cloud Run injects this automatically — no manual action needed)
APP_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"
