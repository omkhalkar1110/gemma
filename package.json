  "version": "1.0.0",
  "description": "Aegis Gateway DLP Proxy & Gemma 4 Threat Intelligence Platform for Google Cloud Run",
  "type": "module",
  "scripts": {
    "dev": "npx tsx server.ts",
    "build": "vite build",
