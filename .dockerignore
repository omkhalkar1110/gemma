# =============================================================================
# .dockerignore — Exclude secrets, dev files, and large directories
# =============================================================================

# Dependencies (rebuilt inside the container)
node_modules/

# Git metadata
.git
.gitignore

# ALL environment files (secrets must be injected at runtime, never baked in)
.env
.env.*
!.env.example

# Build artifacts (rebuilt inside container)
dist/
build/

# Database files (contains user data — never bake into image)
*.db
*.sqlite
*.sqlite3
aegis.db

# Credentials & keys (catch-all)
*.pem
*.key
*.p12
service-account*.json
credentials*.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker & CI config (not needed inside image)
Dockerfile
docker-compose*.yml
cloudbuild.yaml
.gcloudignore

# Temporary files
tmp/
